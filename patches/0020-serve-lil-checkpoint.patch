 # and lut[high nibble].
+_PLE_E2M1_LUT = torch.tensor(
+    [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
+     -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0],
+    dtype=torch.float32,
+)
+
+
+def _dequant_mxfp8_block(
+    weight: torch.Tensor, scale: torch.Tensor, dtype: torch.dtype = torch.bfloat16
+) -> torch.Tensor:
+    # mxfp8 group-32 view of a serialized linear: e4m3 payload times 2^(exponent - 127) per
+    # 32-column block. The checkpoint ships the ue8m0 exponent either as raw uint8 or the torch float8_e8m0fnu view.
+    if scale.dtype == torch.uint8:
+        exponent = scale.to(torch.int32)
+    elif "float8_e8m0" in str(scale.dtype):
+        exponent = scale.view(torch.uint8).to(torch.int32)
+    else:
+        raise ValueError(f"unexpected mxfp8 scale dtype {scale.dtype}")
+    mult = torch.pow(2.0, exponent.to(torch.float32) - 127.0).repeat_interleave(
+        32, dim=1
+    )
+    return (weight.to(torch.float32) * mult).to(dtype)
 
 
