+        and bool(getattr(config, "ple_offload_embedding", False))
+        and getattr(config, "ple_offload_backend", "pinned") == "pinned"
+        and os.environ.get("SGLANG_PLE_PACKED_NVFP4", "1") == "1"
+    )
